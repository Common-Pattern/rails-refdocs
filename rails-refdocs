has_topic() {
  local wanted="$1" topic
  for topic in "${CONFIGURED[@]}"; do
    [[ "$topic" == "$wanted" ]] && return 0
  done
  return 1
}

join_titles() {
  local titles=() topic
  for topic in "$@"; do
    titles+=("$(topic_title "$topic")")
  done
  case "${#titles[@]}" in
    0) ;;
    1) printf '%s' "${titles[0]}" ;;
    *)
      local last="${titles[-1]}"
      unset 'titles[-1]'
      local IFS=,
      printf '%s and %s' "${titles[*]}" "$last" | sed 's/,/, /g'
      ;;
  esac
}

write_readme() {
  local topic rows="" layout="" cmd="$REFDOCS_COMMAND"
  for topic in "${CONFIGURED[@]}"; do
    rows+="$(manifest_row "$topic")"$'\n'
    layout+="$(topic_layout "$topic")"$'\n'
  done
  {
    cat <<MD
# reference/

Local, greppable API references and guides for this Ruby on Rails app's
stack: $(join_titles "${CONFIGURED[@]}"). Everything is Markdown (or SCSS/TSV)
generated from upstream sources, so \`grep\`, \`cat\` and \`sed -n\` are all
you need. Generated by [rails-refdocs](https://github.com/Common-Pattern/rails-refdocs).

Only this README, \`TOPICS\` and \`VERSIONS\` are committed. Everything else
under \`reference/\` is gitignored. \`TOPICS\` lists the topics and their
version pins; on a fresh checkout, or when \`TOPICS\` or \`VERSIONS\` changes,
run:

\`\`\`sh
$cmd update            # every topic, skips what is current
$cmd update rails      # one topic
$cmd check             # recorded vs resolved versions, fetches nothing
$cmd update --force ruby
\`\`\`

## Versions

| Folder | Version | Fetched (UTC) | Source |
| --- | --- | --- | --- |
${rows}
Machine-readable copy: \`reference/VERSIONS\` (TSV: topic, version, fetched, source).

## Searching

Because the topic folders are gitignored, ripgrep (and tools built on it)
skip them unless told otherwise. In a git worktree the topic folders may be
symlinks into the main checkout (\`$cmd link\`), which \`grep -r\` and plain
\`rg\` do not follow when searching \`reference/\` as a whole. Use \`grep -R\`
or \`rg -uuL\`:

\`\`\`sh
grep -Rn 'pattern' reference/
rg -uuL -n 'pattern' reference/
\`\`\`
MD
    if has_topic ruby || has_topic rails; then
      cat <<'MD'

Find the API file for a Ruby or Rails class or method through the two TSV
indexes that sit next to each generated API tree:

```sh
grep -P '^ActiveRecord::Base\t' reference/rails/CLASSES.tsv
grep -P '#validates\t' reference/rails/METHODS.tsv
grep -P '^String#gsub\t' reference/ruby/METHODS.tsv
```

- `CLASSES.tsv`: `Full::Name<TAB>api/path.md<TAB>first sentence of its docs`
- `METHODS.tsv`: `Full::Name#instance_method` or `Full::Name.class_method`, `<TAB>api/path.md`

Class and module files map namespaces to folders: `ActiveRecord::Base` is
`reference/rails/api/ActiveRecord/Base.md`, `Net::HTTP` is
`reference/ruby/api/Net/HTTP.md`. Each API file has the class/module line,
`Defined in:` source paths, includes/extends, the class docs, then
`## Constants`, `## Attributes`, `## Class methods` (`### .name`) and
`## Instance methods` (`### #name`), each method with its signature and a
`Source:` path in the upstream repo. Methods are documented where they are
defined: `save` lives in `ActiveRecord/Persistence.md`, not
`ActiveRecord/Base.md`. Use `METHODS.tsv` or the `Includes:`/`Extends:` lines
to follow them.
MD
    fi
    if has_topic postgres; then
      cat <<'MD'

PostgreSQL pages keep the names of the official HTML pages
(`postgresql.org/docs/<major>/<name>.html` is `reference/postgres/docs/<name>.md`).
`reference/postgres/TITLES.tsv` maps each name to its heading:

```sh
grep -i 'uuid' reference/postgres/TITLES.tsv
grep -Rn 'uuidv7' reference/postgres/docs
```
MD
    fi
    printf '\n## Layout\n\n%s' "$layout"
    if has_topic turbo || has_topic stimulus; then
      cat <<'MD'

Turbo and Stimulus site docs are not tagged upstream; their version string
records the npm package version, the Rails gem version and the site commit.
MD
    fi
  } >"$REF_DIR/README.md"
}

update_topic() {
  local topic="$1" latest recorded
  latest="$(resolve_topic_version "$topic")"
  [[ -n "$latest" ]] || die "$topic: no release matches pin '${PINS[$topic]:-}'"
  recorded="$(recorded_field "$topic" 2)"
  if ((CHECK_ONLY)); then
    printf '%-18s pin=%-8s recorded=%-40s resolved=%s\n' "$topic" "${PINS[$topic]:-latest}" "${recorded:-none}" "$latest"
    return
  fi
  if ((!FORCE)) && [[ "$recorded" == "$latest" && -d "$REF_DIR/$topic" ]]; then
    log "$topic $latest: up to date"
    return
  fi
  fetch_topic "$topic" "$latest"
}

is_known_topic() {
  local topic
  for topic in "${KNOWN_TOPICS[@]}"; do
    [[ "$topic" == "$1" ]] && return 0
  done
  return 1
}

load_topics() {
  [[ -f "$TOPICS_FILE" ]] || die "$TOPICS_FILE is missing; list one topic per line (known: ${KNOWN_TOPICS[*]})"
  local line topic pin extra listed=()
  while IFS= read -r line || [[ -n "$line" ]]; do
    line="${line%%#*}"
    read -r topic pin extra <<<"$line" || true
    [[ -n "${topic:-}" ]] || continue
    [[ -z "${extra:-}" ]] || die "$TOPICS_FILE: '$line' has more than a topic and a pin"
    is_known_topic "$topic" || die "$TOPICS_FILE: unknown topic '$topic' (known: ${KNOWN_TOPICS[*]})"
    if [[ -n "${pin:-}" ]]; then
      [[ "$topic" != turbo && "$topic" != stimulus ]] || die "$TOPICS_FILE: $topic takes no pin"
      [[ "$pin" =~ ^[0-9]+(\.[0-9]+)*$ ]] || die "$TOPICS_FILE: pin '$pin' for $topic is not a version prefix"
      PINS[$topic]="$pin"
    fi
    listed+=("$topic")
  done <"$TOPICS_FILE"
  CONFIGURED=()
  for topic in "${KNOWN_TOPICS[@]}"; do
    for line in "${listed[@]}"; do
      if [[ "$line" == "$topic" ]]; then
        CONFIGURED+=("$topic")
        break
      fi
    done
  done
  ((${#CONFIGURED[@]} > 0)) || die "$TOPICS_FILE lists no topics"
}

select_topics() {
  local wanted topic
  if (($# == 0)); then
    SELECTED=("${CONFIGURED[@]}")
    return
  fi
  SELECTED=()
  for topic in "${CONFIGURED[@]}"; do
    for wanted in "$@"; do
      [[ "$wanted" == "$topic" ]] && SELECTED+=("$topic")
    done
  done
  for wanted in "$@"; do
    has_topic "$wanted" || die "$wanted is not listed in $TOPICS_FILE"
  done
}

run_update() {
  local topics=() topic
  while (($# > 0)); do
    case "$1" in
      --force) FORCE=1 ;;
      -*) usage >&2; die "unknown option: $1" ;;
      *) topics+=("$1") ;;
    esac
    shift
  done
  load_topics
  select_topics "${topics[@]}"
  require_commands curl git jq tar awk sort
  mkdir -p "$REF_DIR"
  WORK_DIR="$(mktemp -d "${TMPDIR:-/tmp}/rails-refdocs.XXXXXX")"
  trap cleanup_work_dir EXIT
  ((CHECK_ONLY)) || write_rdoc_generator
  for topic in "${SELECTED[@]}"; do
    update_topic "$topic" </dev/null
  done
  ((CHECK_ONLY)) && return
  write_readme
  log "done; versions recorded in $MANIFEST, index in $REF_DIR/README.md"
}

run_link() {
  local here main rel dir target topics=()
  here="$(git -C "$REF_DIR/.." rev-parse --show-toplevel)"
  main="$(dirname "$(git -C "$here" rev-parse --path-format=absolute --git-common-dir)")"
  [[ "$main" == "$here" ]] && return 0
  rel="${REF_DIR#"$here"/}"
  shopt -s nullglob
  topics=("$main/$rel"/*/)
  if ((${#topics[@]} == 0)); then
    printf 'rails-refdocs link: %s has no topics; run %s update there\n' "$main/$rel" "$REFDOCS_COMMAND" >&2
    return 0
  fi
  mkdir -p "$REF_DIR"
  for dir in "${topics[@]}"; do
    target="$REF_DIR/$(basename "$dir")"
    [[ -e "$target" && ! -L "$target" ]] && continue
    ln -sfn "${dir%/}" "$target"
  done
}

default_ref_dir() {
  local top
  top="$(git rev-parse --show-toplevel 2>/dev/null)" || top="$PWD"
  printf '%s/reference\n' "$top"
}

main() {
  local dir="" command=""
  while (($# > 0)); do
    case "$1" in
      -h | --help | help) usage; exit 0 ;;
      --dir) dir="${2:?--dir needs a value}"; shift ;;
      --dir=*) dir="${1#--dir=}" ;;
      -*) usage >&2; die "unknown option: $1" ;;
      *) command="$1"; shift; break ;;
    esac
    shift
  done
  [[ -n "$dir" ]] || dir="$(default_ref_dir)"
  if [[ -d "$dir" ]]; then
    REF_DIR="$(cd "$dir" && pwd)"
  elif [[ "$dir" == /* ]]; then
    REF_DIR="$dir"
  else
    REF_DIR="$PWD/$dir"
  fi
  MANIFEST="$REF_DIR/VERSIONS"
  TOPICS_FILE="$REF_DIR/TOPICS"
  case "$command" in
    update) run_update "$@" ;;
    check) CHECK_ONLY=1; run_update "$@" ;;
    link) run_link ;;
    topics) printf '%s\n' "${KNOWN_TOPICS[@]}" ;;
    "") usage >&2; exit 1 ;;
    *) usage >&2; die "unknown command: $command" ;;
  esac
}

main "$@"

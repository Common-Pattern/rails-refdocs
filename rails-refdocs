#!/usr/bin/env bash
set -euo pipefail

KNOWN_TOPICS=(ruby rails postgres view_component bootstrap turbo stimulus importmap-rails dartsass-rails solid_queue letter_opener_web)
PANDOC_IMAGE="docker.io/pandoc/core:3.11"
REFDOCS_COMMAND="${REFDOCS_COMMAND:-rails-refdocs}"
REF_DIR=""
MANIFEST=""
TOPICS_FILE=""
FORCE=0
CHECK_ONLY=0
WORK_DIR=""
declare -A PINS=()
CONFIGURED=()
SELECTED=()

usage() {
  cat <<USAGE
Usage: rails-refdocs [--dir DIR] <command> [options]

Keeps local, greppable Markdown copies of the API references and guides for
a Ruby on Rails app's stack in DIR (default: reference/ at the top of the current git checkout).

Commands:
  update [--force] [topic ...]  fetch every configured topic whose recorded
                                version differs from the version its pin
                                resolves to (--force: fetch anyway)
  check [topic ...]             print recorded and resolved versions, fetch
                                nothing
  link                          in a git worktree, symlink each topic folder
                                of the main checkout's DIR into this one
  topics                        list the topics rails-refdocs knows

DIR/TOPICS configures a checkout: one topic per line, optionally followed by
a version pin. A pin is a version prefix: "rails 8.1" resolves to the latest
8.1.x release, "postgres 18" to the latest 18.x, "bootstrap 5.3.8" to
exactly that. Without a pin the latest release is used. turbo and stimulus
take no pin. Blank lines and lines starting with # are ignored.

Topics: ${KNOWN_TOPICS[*]}

Needs: bash, curl, git, jq, tar, and podman or docker (ruby and rails run
rdoc inside docker.io/library/ruby:<version>-slim, postgres runs pandoc
inside $PANDOC_IMAGE). Override the container runtime with
CONTAINER_RUNTIME=docker. REFDOCS_COMMAND names the command in the generated
README (default: rails-refdocs).
USAGE
}

log() {
  printf '==> %s\n' "$*" >&2
}

die() {
  printf 'error: %s\n' "$*" >&2
  exit 1
}

require_commands() {
  local cmd
  for cmd in "$@"; do
    command -v "$cmd" >/dev/null 2>&1 || die "missing required command: $cmd"
  done
}

cleanup_work_dir() {
  if [[ -n "$WORK_DIR" && -d "$WORK_DIR" ]]; then
    rm -rf "$WORK_DIR"
  fi
  rm -rf "$REF_DIR/.staging"
}

http_get() {
  curl -fsSL --retry 3 --retry-delay 2 "$@"
}

pick_version() {
  grep -E '^[0-9]+(\.[0-9]+)*$' \
    | awk -v p="$1" 'p == "" || $0 == p || index($0, p ".") == 1' \
    | sort -u -V \
    | tail -n 1
}

latest_gem_version() {
  http_get "https://rubygems.org/api/v1/versions/$1.json" | jq -r '.[].number' | pick_version "${2:-}"
}

latest_npm_version() {
  http_get "https://registry.npmjs.org/$1" | jq -r '.versions | keys[]' | pick_version "${2:-}"
}

latest_ruby_version() {
  http_get "https://cache.ruby-lang.org/pub/ruby/index.txt" \
    | awk '{print $1}' \
    | sed -n 's/^ruby-\([0-9][0-9]*\.[0-9][0-9]*\.[0-9][0-9]*\)$/\1/p' \
    | pick_version "${1:-}"
}

latest_postgres_version() {
  http_get "https://ftp.postgresql.org/pub/source/" \
    | grep -o 'v[0-9][0-9.]*/' \
    | tr -d v/ \
    | pick_version "${1:-}"
}

github_head_sha() {
  git ls-remote "https://github.com/$1" HEAD | cut -c1-12
}

resolve_topic_version() {
  local topic="$1" pin="${PINS[$1]:-}"
  case "$topic" in
    ruby) latest_ruby_version "$pin" ;;
    rails) latest_gem_version rails "$pin" ;;
    postgres) latest_postgres_version "$pin" ;;
    view_component) latest_gem_version view_component "$pin" ;;
    bootstrap) latest_npm_version bootstrap "$pin" ;;
    turbo)
      printf 'turbo-%s+turbo-rails-%s+site-%s\n' \
        "$(latest_npm_version @hotwired/turbo)" \
        "$(latest_gem_version turbo-rails)" \
        "$(github_head_sha hotwired/turbo-site)"
      ;;
    stimulus)
      printf 'stimulus-%s+stimulus-rails-%s+site-%s\n' \
        "$(latest_npm_version @hotwired/stimulus)" \
        "$(latest_gem_version stimulus-rails)" \
        "$(github_head_sha hotwired/stimulus-site)"
      ;;
    importmap-rails) latest_gem_version importmap-rails "$pin" ;;
    dartsass-rails) latest_gem_version dartsass-rails "$pin" ;;
    solid_queue) latest_gem_version solid_queue "$pin" ;;
    letter_opener_web) latest_gem_version letter_opener_web "$pin" ;;
    *) die "unknown topic: $topic" ;;
  esac
}

version_component() {
  tr '+' '\n' <<<"$1" | sed -n "s/^$2-\([0-9].*\)\$/\1/p"
}

recorded_field() {
  local topic="$1" column="$2"
  [[ -f "$MANIFEST" ]] || return 0
  awk -F '\t' -v t="$topic" -v c="$column" '$1 == t { print $c }' "$MANIFEST"
}

record_version() {
  local topic="$1" version="$2" source="$3" today tmp
  today="$(date -u +%F)"
  tmp="$(mktemp)"
  if [[ -f "$MANIFEST" ]]; then
    awk -F '\t' -v t="$topic" 'NR > 1 && $1 != t' "$MANIFEST" >"$tmp.rows"
  else
    : >"$tmp.rows"
  fi
  printf '%s\t%s\t%s\t%s\n' "$topic" "$version" "$today" "$source" >>"$tmp.rows"
  {
    printf 'topic\tversion\tfetched\tsource\n'
    sort -t "$(printf '\t')" -k1,1 "$tmp.rows"
  } >"$tmp"
  mv "$tmp" "$MANIFEST"
  rm -f "$tmp.rows"
}

shallow_clone() {
  local repo="$1" ref="$2" dest="$3"
  shift 3
  local clone_args=(--quiet --depth 1 --filter=blob:none -c advice.detachedHead=false)
  [[ "$ref" != HEAD ]] && clone_args+=(--branch "$ref")
  if (($# > 0)); then
    git clone "${clone_args[@]}" --sparse "https://github.com/$repo" "$dest"
    git -C "$dest" sparse-checkout set "$@" >/dev/null
  else
    git clone "${clone_args[@]}" "https://github.com/$repo" "$dest"
  fi
}

fetch_raw_file() {
  local repo="$1" ref="$2" path="$3" dest="$4"
  mkdir -p "$(dirname "$dest")"
  http_get "https://raw.githubusercontent.com/$repo/$ref/$path" -o "$dest"
}

copy_text_files() {
  local src="$1" dest="$2"
  shift 2
  local name_args=() pattern
  for pattern in "$@"; do
    ((${#name_args[@]} > 0)) && name_args+=(-o)
    name_args+=(-name "$pattern")
  done
  mkdir -p "$dest"
  (cd "$src" && find . -type f \( "${name_args[@]}" \) -print0 | tar --null -T - -cf -) | tar -C "$dest" -xf -
}

container_runtime() {
  if [[ -n "${CONTAINER_RUNTIME:-}" ]]; then
    printf '%s\n' "$CONTAINER_RUNTIME"
  elif command -v podman >/dev/null 2>&1; then
    printf 'podman\n'
  elif command -v docker >/dev/null 2>&1; then
    printf 'docker\n'
  else
    die "ruby and rails need podman or docker"
  fi
}

ruby_image() {
  local version
  version="$(recorded_field ruby 2)"
  [[ -n "$version" ]] || version="$(latest_ruby_version)"
  printf 'docker.io/library/ruby:%s-slim\n' "$version"
}

run_in_ruby_container() {
  local src="$1" out="$2"
  shift 2
  local runtime user_args=()
  runtime="$(container_runtime)"
  [[ "$runtime" == docker ]] && user_args=(--user "$(id -u):$(id -g)")
  "$runtime" run --rm "${user_args[@]}" \
    -v "$src:/src:ro,Z" \
    -v "$WORK_DIR/rdoc:/gen:ro,Z" \
    -v "$out:/out:Z" \
    -w /src \
    "$(ruby_image)" "$@"
}

write_rdoc_generator() {
  mkdir -p "$WORK_DIR/rdoc"
  cat >"$WORK_DIR/rdoc/reference_markdown.rb" <<'RUBY'
require "rdoc"
require "fileutils"

class RDoc::Generator::ReferenceMarkdown
  RDoc::RDoc.add_generator self

  def self.setup_options(options)
  end

  def initialize(store, options)
    @store = store
    @options = options
  end

  def class_dir
    nil
  end

  def file_dir
    nil
  end

  def generate
    root = File.expand_path(@options.op_dir)
    class_index = []
    method_index = []
    @store.all_classes_and_modules.sort_by(&:full_name).each do |mod|
      next unless mod.display?
      relative = "api/" + mod.full_name.split("::").join("/") + ".md"
      write_file(File.join(root, relative), render_module(mod))
      class_index << [mod.full_name, relative, summary_of(mod)]
      visible_methods(mod).each do |meth|
        method_index << ["#{mod.full_name}#{meth.singleton ? "." : "#"}#{meth.name}", relative]
      end
    end
    @store.all_files.each do |file|
      next unless file.text? && file.display?
      relative = file.relative_name.sub(%r{\A\.?/}, "")
      target = relative.end_with?(".md") ? relative : "#{relative}.md"
      write_file(File.join(root, "pages", target), to_markdown(file, file.comment) + "\n")
    end
    write_file(File.join(root, "CLASSES.tsv"), class_index.map { |row| row.join("\t") }.join("\n") + "\n")
    write_file(File.join(root, "METHODS.tsv"), method_index.sort.map { |row| row.join("\t") }.join("\n") + "\n")
  end

  private

  def write_file(path, content)
    FileUtils.mkdir_p(File.dirname(path))
    File.write(path, content)
  end

  def to_markdown(code_object, comment)
    return "" if comment.nil? || (comment.respond_to?(:empty?) && comment.empty?)
    code_object.parse(comment).accept(RDoc::Markup::ToMarkdown.new).strip
  rescue StandardError
    comment.to_s.strip
  end

  def summary_of(mod)
    paragraphs = to_markdown(mod, mod.comment_location).split(/\n[ \t]*\n/)
    first = paragraphs.find { |para| !para.strip.empty? && !para.start_with?("#", "    ", "```") } || ""
    first.strip.gsub(/\s+/, " ")[0, 200]
  end

  def visible_methods(mod)
    mod.method_list
      .select { |meth| meth.display? && meth.visibility != :private }
      .sort_by { |meth| [meth.singleton ? 0 : 1, meth.name] }
  end

  def kind_line(mod)
    return "module #{mod.full_name}" if mod.module?
    parent = mod.superclass
    parent_name = parent.respond_to?(:full_name) ? parent.full_name : parent.to_s
    parent_name.empty? ? "class #{mod.full_name}" : "class #{mod.full_name} < #{parent_name}"
  end

  def render_module(mod)
    out = ["# #{mod.full_name}", "", "`#{kind_line(mod)}`", ""]
    files = mod.in_files.map(&:relative_name).uniq
    out << "Defined in: #{files.map { |f| "`#{f}`" }.join(", ")}" unless files.empty?
    includes = mod.includes.map(&:name)
    extends = mod.extends.map(&:name)
    out << "Includes: #{includes.join(", ")}" unless includes.empty?
    out << "Extends: #{extends.join(", ")}" unless extends.empty?
    out << ""
    description = to_markdown(mod, mod.comment_location)
    out << description << "" unless description.empty?
    out.concat(render_constants(mod))
    out.concat(render_attributes(mod))
    methods = visible_methods(mod)
    [[true, "Class methods"], [false, "Instance methods"]].each do |singleton, title|
      group = methods.select { |meth| meth.singleton == singleton }
      next if group.empty?
      out << "## #{title}" << ""
      group.each { |meth| out.concat(render_method(meth)) }
    end
    out.join("\n").gsub(/\n{3,}/, "\n\n") + "\n"
  end

  def render_constants(mod)
    constants = mod.constants.select(&:display?)
    return [] if constants.empty?
    out = ["## Constants", ""]
    constants.each do |const|
      out << "### #{const.name}" << ""
      value = const.value.to_s
      value = value[0, 300] + " ..." if value.length > 300
      out << "```ruby\n#{const.name} = #{value}\n```" << "" unless value.empty?
      text = to_markdown(const, const.comment)
      out << text << "" unless text.empty?
    end
    out
  end

  def render_attributes(mod)
    attributes = mod.attributes.select { |attr| attr.display? && attr.visibility != :private }
    return [] if attributes.empty?
    out = ["## Attributes", ""]
    attributes.each do |attr|
      out << "### #{attr.singleton ? "." : "#"}#{attr.name} [#{attr.rw}]" << ""
      text = to_markdown(attr, attr.comment)
      out << text << "" unless text.empty?
    end
    out
  end

  def render_method(meth)
    visibility = meth.visibility == :public ? "" : " (#{meth.visibility})"
    out = ["### #{meth.singleton ? "." : "#"}#{meth.name}#{visibility}", ""]
    signature = meth.call_seq ? meth.call_seq.strip : "#{meth.name}#{meth.params}"
    out << "```ruby\n#{signature}\n```" << ""
    if meth.is_alias_for
      target = meth.is_alias_for
      out << "Alias for `#{target.respond_to?(:full_name) ? target.full_name : target}`." << ""
    end
    text = to_markdown(meth, meth.comment)
    out << text << "" unless text.empty?
    out << "Source: `#{meth.file.relative_name}#{meth.line ? ":#{meth.line}" : ""}`" << "" if meth.file
    out
  end
end

RDoc::RDoc.new.document(ARGV)
RUBY
}

generate_rdoc_markdown() {
  local src="$1" out="$2" file_list_command="$3"
  mkdir -p "$out"
  run_in_ruby_container "$src" "$out" bash -c "ruby /gen/reference_markdown.rb --quiet --format=referencemarkdown --output=/out/gen --encoding=UTF-8 -x '\.ja\.' -x '/ja/' -x COPYING -x LEGAL \$($file_list_command)"
  rm -f "$out/gen/created.rid"
}

move_generated_api() {
  local out="$1" stage="$2"
  mv "$out/gen/api" "$out/gen/pages" "$out/gen/CLASSES.tsv" "$out/gen/METHODS.tsv" "$stage/"
}

fetch_ruby() {
  local version="$1" stage="$2" minor src
  minor="${version%.*}"
  src="$WORK_DIR/ruby-src"
  mkdir -p "$src"
  log "ruby $version: downloading source tarball"
  http_get "https://cache.ruby-lang.org/pub/ruby/$minor/ruby-$version.tar.xz" | tar -xJ -C "$src" --strip-components 1
  log "ruby $version: generating API markdown with rdoc (about 30s)"
  generate_rdoc_markdown "$src" "$WORK_DIR/ruby-out" "echo ."
  move_generated_api "$WORK_DIR/ruby-out" "$stage"
}

rails_api_file_list() {
  cat <<'EOF'
shopt -s globstar nullglob
files=(railties/RDOC_MAIN.md)
for component in activesupport activerecord activemodel actionpack actionview actionmailer activejob actioncable activestorage actionmailbox actiontext railties; do
  files+=("$component"/README.* "$component"/lib/**/*.rb "$component"/app/**/*.rb)
done
printf '%s\n' "${files[@]}" | grep -vE '/templates/|action_view/vendor/|lib/rails/test_unit/|lib/rails/api/generator\.rb|/app/(javascript|assets)/'
EOF
}

fetch_rails() {
  local version="$1" stage="$2" src="$WORK_DIR/rails-src" out="$WORK_DIR/rails-out"
  log "rails $version: cloning rails/rails at v$version"
  shallow_clone rails/rails "v$version" "$src"
  mkdir -p "$stage/guides"
  copy_text_files "$src/guides/source" "$stage/guides" '*.md' '*.yaml'
  find "$stage/guides" -maxdepth 1 -name '[2-6]_*_release_notes.md' -delete
  rails_api_file_list >"$src/.reference-file-list.sh"
  log "rails $version: generating API markdown with rdoc (about 15s)"
  generate_rdoc_markdown "$src" "$out" "bash .reference-file-list.sh"
  move_generated_api "$out" "$stage"
}

write_pandoc_filter() {
  cat >"$1" <<'EOF'
function Div(el)
  if el.classes:includes("navheader") or el.classes:includes("navfooter") then
    return {}
  end
  return el.content
end

function Span(el)
  return el.content
end

function Link(el)
  if pandoc.utils.stringify(el.content) == "#" then
    return {}
  end
  if not el.target:match("^%a+:") then
    el.target = el.target:gsub("%.html", ".md", 1)
  end
  el.title = ""
  return el
end

function CodeBlock(el)
  el.classes = {}
  return el
end

function LineBreak()
  return pandoc.Space()
end

local function row_item(row)
  local blocks = {}
  for _, cell in ipairs(row.cells) do
    for _, b in ipairs(cell.contents) do
      table.insert(blocks, b)
    end
  end
  return blocks
end

function Table(tbl)
  local items = {}
  for _, row in ipairs(tbl.head.rows) do
    table.insert(items, row_item(row))
  end
  for _, body in ipairs(tbl.bodies) do
    for _, row in ipairs(body.head) do
      table.insert(items, row_item(row))
    end
    for _, row in ipairs(body.body) do
      table.insert(items, row_item(row))
    end
  end
  return pandoc.BulletList(items)
end
EOF
}

fetch_postgres() {
  local version="$1" stage="$2" src="$WORK_DIR/postgres-src" runtime user_args=() file
  log "postgres $version: fetching the HTML docs tarball and converting with pandoc"
  mkdir -p "$src/html" "$stage/docs"
  http_get "https://ftp.postgresql.org/pub/source/v$version/postgresql-$version-docs.tar.gz" \
    | tar -xz -C "$src/html" --strip-components=5 --wildcards "postgresql-$version/doc/src/sgml/html/*.html"
  sed -i -e 's/<pre\( [^>]*\)\{0,1\}>/&<code>/g' -e 's|</pre>|</code></pre>|g' "$src"/html/*.html
  write_pandoc_filter "$src/postgres.lua"
  cat >"$src/convert.sh" <<'EOF'
ls *.html | xargs -P "$(nproc)" -I{} sh -c 'pandoc -f html -t gfm-raw_html --wrap=none --lua-filter /src/postgres.lua "$1" -o "/out/${1%.html}.md"' _ {}
EOF
  runtime="$(container_runtime)"
  [[ "$runtime" == docker ]] && user_args=(--user "$(id -u):$(id -g)")
  "$runtime" run --rm "${user_args[@]}" \
    -v "$src:/src:ro,Z" \
    -v "$stage/docs:/out:Z" \
    -w /src/html \
    --entrypoint sh \
    "$PANDOC_IMAGE" /src/convert.sh
  for file in "$stage"/docs/*.md; do
    sed -i -e 's/\xe2\x80\x8b//g' -e 's/[[:space:]]*$//' "$file"
  done
  (cd "$stage/docs" && for file in *.md; do
    printf '%s\t%s\n' "${file%.md}" "$(sed -n 's/^#\{1,6\} //p' "$file" | head -n 1)"
  done) | sort >"$stage/TITLES.tsv"
}

fetch_view_component() {
  local version="$1" stage="$2" src="$WORK_DIR/vc-src"
  log "view_component $version: cloning docs at v$version"
  shallow_clone ViewComponent/view_component "v$version" "$src" docs
  copy_text_files "$src/docs" "$stage/docs" '*.md'
  cp "$src/README.md" "$stage/README.md"
}

fetch_bootstrap() {
  local version="$1" stage="$2" src="$WORK_DIR/bootstrap-src" docs_dir
  log "bootstrap $version: cloning docs and scss at v$version"
  shallow_clone twbs/bootstrap "v$version" "$src" site/src/content/docs site/content/docs scss
  if [[ -d "$src/site/src/content/docs" ]]; then
    docs_dir="$src/site/src/content/docs"
  elif [[ -d "$src/site/content/docs" ]]; then
    docs_dir="$src/site/content/docs"
  else
    die "bootstrap $version: no docs directory found"
  fi
  copy_text_files "$docs_dir" "$stage/docs" '*.md' '*.mdx'
  copy_text_files "$src/scss" "$stage/scss" '*.scss'
  rm -rf "$stage/scss/tests"
}

fetch_hotwire_site() {
  local site_repo="$1" rails_repo="$2" rails_version="$3" js_repo="$4" js_version="$5" stage="$6"
  local src
  src="$WORK_DIR/$(basename "$site_repo")-src"
  shallow_clone "$site_repo" HEAD "$src" _source/handbook _source/reference
  copy_text_files "$src/_source/handbook" "$stage/handbook" '*.md'
  copy_text_files "$src/_source/reference" "$stage/reference" '*.md'
  fetch_raw_file "$rails_repo" "v$rails_version" README.md "$stage/$(basename "$rails_repo")-README.md"
  fetch_raw_file "$js_repo" "v$js_version" README.md "$stage/$(basename "$js_repo")-js-README.md"
}

fetch_turbo() {
  local version="$1" stage="$2"
  log "turbo $version: fetching turbo-site handbook/reference and READMEs"
  fetch_hotwire_site hotwired/turbo-site \
    hotwired/turbo-rails "$(version_component "$version" turbo-rails)" \
    hotwired/turbo "$(version_component "$version" turbo)" "$stage"
}

fetch_stimulus() {
  local version="$1" stage="$2"
  log "stimulus $version: fetching stimulus-site handbook/reference and READMEs"
  fetch_hotwire_site hotwired/stimulus-site \
    hotwired/stimulus-rails "$(version_component "$version" stimulus-rails)" \
    hotwired/stimulus "$(version_component "$version" stimulus)" "$stage"
}

fetch_importmap_rails() {
  log "importmap-rails $1: fetching README"
  fetch_raw_file rails/importmap-rails "v$1" README.md "$2/README.md"
}

fetch_dartsass_rails() {
  log "dartsass-rails $1: fetching README"
  fetch_raw_file rails/dartsass-rails "v$1" README.md "$2/README.md"
}

fetch_solid_queue() {
  local version="$1" stage="$2" src="$WORK_DIR/solid_queue-src"
  log "solid_queue $version: fetching README, UPGRADING and docs/ at v$version"
  shallow_clone rails/solid_queue "v$version" "$src" docs
  cp "$src/README.md" "$stage/README.md"
  [[ -f "$src/UPGRADING.md" ]] && cp "$src/UPGRADING.md" "$stage/UPGRADING.md"
  [[ -d "$src/docs" ]] && copy_text_files "$src/docs" "$stage/docs" '*.md'
  return 0
}

fetch_letter_opener_web() {
  log "letter_opener_web $1: fetching README"
  fetch_raw_file fgrehm/letter_opener_web "v$1" README.md "$2/README.md"
}

topic_source() {
  case "$1" in
    ruby) printf 'https://cache.ruby-lang.org/pub/ruby/ (tarball, rdoc)\n' ;;
    rails) printf 'https://github.com/rails/rails (tag, guides/source + rdoc)\n' ;;
    postgres) printf 'https://ftp.postgresql.org/pub/source/ (docs tarball, pandoc)\n' ;;
    view_component) printf 'https://github.com/ViewComponent/view_component (tag, docs/)\n' ;;
    bootstrap) printf 'https://github.com/twbs/bootstrap (tag, site docs + scss/)\n' ;;
    turbo) printf 'https://github.com/hotwired/turbo-site (main) + hotwired/turbo-rails, hotwired/turbo READMEs (tags)\n' ;;
    stimulus) printf 'https://github.com/hotwired/stimulus-site (main) + hotwired/stimulus-rails, hotwired/stimulus READMEs (tags)\n' ;;
    importmap-rails) printf 'https://github.com/rails/importmap-rails (tag, README)\n' ;;
    dartsass-rails) printf 'https://github.com/rails/dartsass-rails (tag, README)\n' ;;
    solid_queue) printf 'https://github.com/rails/solid_queue (tag, README + UPGRADING + docs/ if present)\n' ;;
    letter_opener_web) printf 'https://github.com/fgrehm/letter_opener_web (tag, README)\n' ;;
  esac
}

fetch_topic() {
  local topic="$1" version="$2" stage="$REF_DIR/.staging/$1"
  rm -rf "$stage"
  mkdir -p "$stage"
  case "$topic" in
    ruby) fetch_ruby "$version" "$stage" ;;
    rails) fetch_rails "$version" "$stage" ;;
    postgres) fetch_postgres "$version" "$stage" ;;
    view_component) fetch_view_component "$version" "$stage" ;;
    bootstrap) fetch_bootstrap "$version" "$stage" ;;
    turbo) fetch_turbo "$version" "$stage" ;;
    stimulus) fetch_stimulus "$version" "$stage" ;;
    importmap-rails) fetch_importmap_rails "$version" "$stage" ;;
    dartsass-rails) fetch_dartsass_rails "$version" "$stage" ;;
    solid_queue) fetch_solid_queue "$version" "$stage" ;;
    letter_opener_web) fetch_letter_opener_web "$version" "$stage" ;;
  esac
  rm -rf "${REF_DIR:?}/$topic"
  mv "$stage" "$REF_DIR/$topic"
  record_version "$topic" "$version" "$(topic_source "$topic")"
}


manifest_row() {
  local topic="$1" version fetched
  version="$(recorded_field "$topic" 2)"
  fetched="$(recorded_field "$topic" 3)"
  printf "| \`%s/\` | %s | %s | %s |\n" "$topic" "${version:-not fetched}" "${fetched:--}" "$(topic_source "$topic")"
}

topic_title() {
  case "$1" in
    ruby) printf 'Ruby' ;;
    rails) printf 'Rails' ;;
    postgres) printf 'PostgreSQL' ;;
    view_component) printf 'ViewComponent' ;;
    bootstrap) printf 'Bootstrap' ;;
    turbo) printf 'Turbo' ;;
    stimulus) printf 'Stimulus' ;;
    solid_queue) printf 'Solid Queue' ;;
    *) printf '%s' "$1" ;;
  esac
}

topic_layout() {
  case "$1" in
    ruby)
      cat <<'MD'
- `ruby/` Ruby core and standard library (default gems included, bundled
  gems such as csv are not).
  - `api/` one file per class/module, generated by rdoc from the release tarball.
  - `pages/` Ruby's own docs converted to Markdown: `syntax/` (language
    syntax: methods, control expressions, pattern matching, refinements),
    `language/`, `NEWS/` (per-release changes), `NEWS.md`, `standard_library.md`.
  - `CLASSES.tsv`, `METHODS.tsv` indexes.
MD
      ;;
    rails)
      cat <<'MD'
- `rails/` Ruby on Rails.
  - `guides/` the Rails Guides sources (`active_record_querying.md`,
    `routing.md`, `form_helpers.md`, `action_controller_overview.md`,
    `testing.md`, `configuring.md`, `upgrading_ruby_on_rails.md`, release
    notes from 7.0 on). `documents.yaml` is the guides table of contents.
  - `api/` one file per class/module across all Rails frameworks, generated
    by rdoc with the same file set as api.rubyonrails.org.
  - `pages/` each framework's README.
  - `CLASSES.tsv`, `METHODS.tsv` indexes.
MD
      ;;
    postgres)
      cat <<'MD'
- `postgres/` PostgreSQL, the full manual converted from the release's HTML
  docs, one file per page; tables are flattened into lists (one item per
  row, cells in order).
  - `docs/sql-*.md` SQL commands (`sql-createtable.md`,
    `sql-createindex.md`, `sql-select.md`, ...).
  - `docs/datatype-*.md` data types (`datatype-datetime.md`,
    `datatype-uuid.md`, `datatype-json.md`, ...).
  - `docs/functions-*.md` functions and operators (`functions-uuid.md`,
    `functions-datetime.md`, `functions-json.md`, ...).
  - `docs/ddl-*.md` (constraints, partitioning, row security),
    `docs/indexes-*.md`, `docs/mvcc*.md` and `docs/transaction-iso.md`
    (concurrency, locking), `docs/performance-tips.md`, `docs/using-explain.md`,
    `docs/runtime-config-*.md` (server settings), `docs/release-*.md`.
  - `docs/index.md` the table of contents, `docs/bookindex.md` the index.
  - `TITLES.tsv` page name to heading.
MD
      ;;
    view_component)
      cat <<'MD'
- `view_component/` ViewComponent: `docs/guide/*.md` (slots, previews,
  testing, collections, helpers, turbo_streams, ...), `docs/api.md` (full
